# Copie para .env.local e preencha. Nunca commite .env.local.
# Local: rode `npx supabase start` e `npx supabase status` para ver os valores.

# Públicas (vão para o navegador)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Cloudflare Turnstile. Vazio = chave de teste da Cloudflare (sempre passa), só fora de produção.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Secretas (só servidor). Em staging/produção ficam na Vercel, nunca aqui.
SUPABASE_SECRET_KEY=
# Turnstile (secreta). Vazio = segredo de teste, só fora de produção.
TURNSTILE_SECRET_KEY=
# Resend. Vazio = e-mails não são enviados (só fora de produção).
RESEND_API_KEY=
EMAIL_FROM=
